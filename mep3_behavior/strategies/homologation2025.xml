<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="homologation2025">
    <Sequence>
      <ScoreboardTask points="0"
                      task="INIT_DISPLAY"/>
      <WaitMatchStart state="2"/>
      <ScoreboardTask points="20"
                      task="BANNER"/>
      <ForceSuccess>
        <Timeout msec="100000">
          <ForceSuccess>
            <Sequence>
              <ForceSuccess>
                <Timeout msec="85000">
                  <Sequence>
                    <ForceSuccess>
                      <SubTree ID="pull_back_banner"
                               _autoremap="true"/>
                    </ForceSuccess>
                    <ForceSuccess>
                      <RetryUntilSuccessful num_attempts="25">
                        <Fallback>
                          <Move goal="-0.3;-0.5;90"
                                ignore_obstacles="false"
                                linear_velocity="0.5"
                                frame_id="map"
                                angular_velocity="1.0"
                                mode="7"
                                linear_acceleration="0.8"
                                angular_acceleration="1.8"
                                reversing="0"/>
                          <Sequence>
                            <Sleep msec="1000"/>
                            <AlwaysFailure/>
                          </Sequence>
                        </Fallback>
                      </RetryUntilSuccessful>
                    </ForceSuccess>
                    <ForceSuccess>
                      <RetryUntilSuccessful num_attempts="25">
                        <Fallback>
                          <Move goal="-0.3;0.5;-90"
                                ignore_obstacles="false"
                                linear_velocity="0.3"
                                frame_id="map"
                                angular_velocity="1.0"
                                mode="7"
                                linear_acceleration="0.1"
                                angular_acceleration="1.8"
                                reversing="2"/>
                          <Sequence>
                            <Sleep msec="1000"/>
                            <AlwaysFailure/>
                          </Sequence>
                        </Fallback>
                      </RetryUntilSuccessful>
                    </ForceSuccess>
                    <ForceSuccess>
                      <RetryUntilSuccessful num_attempts="25">
                        <Fallback>
                          <Move goal="-0.3;-0.5;90"
                                ignore_obstacles="false"
                                linear_velocity="0.3"
                                frame_id="map"
                                angular_velocity="1.0"
                                mode="7"
                                linear_acceleration="0.1"
                                angular_acceleration="1.8"
                                reversing="0"/>
                          <Sequence>
                            <Sleep msec="1000"/>
                            <AlwaysFailure/>
                          </Sequence>
                        </Fallback>
                      </RetryUntilSuccessful>
                    </ForceSuccess>
                    <ForceSuccess>
                      <RetryUntilSuccessful num_attempts="25">
                        <Fallback>
                          <Move goal="-0.3;0.5;-90"
                                ignore_obstacles="false"
                                linear_velocity="0.3"
                                frame_id="map"
                                angular_velocity="1.0"
                                mode="7"
                                linear_acceleration="0.1"
                                angular_acceleration="1.8"
                                reversing="2"/>
                          <Sequence>
                            <Sleep msec="1000"/>
                            <AlwaysFailure/>
                          </Sequence>
                        </Fallback>
                      </RetryUntilSuccessful>
                    </ForceSuccess>
                    <Sleep msec="120000"/>
                  </Sequence>
                </Timeout>
              </ForceSuccess>
              <ForceSuccess>
                <Repeat num_cycles="7">
                  <Sequence>
                    <Sleep msec="1000"/>
                    <ForceSuccess>
                      <Translate frame_id="base_link"
                                 ignore_obstacles="false"
                                 x="0.6"
                                 error="{error}"
                                 linear_velocity="1.4"
                                 linear_acceleration="0.1"
                                 enable_sensors="true"/>
                    </ForceSuccess>
                    <Sleep msec="1000"/>
                    <ForceSuccess>
                      <Translate frame_id="base_link"
                                 ignore_obstacles="false"
                                 x="-0.6"
                                 error="{error}"
                                 linear_velocity="1.4"
                                 linear_acceleration="0.1"
                                 enable_sensors="true"/>
                    </ForceSuccess>
                  </Sequence>
                </Repeat>
              </ForceSuccess>
              <Sleep msec="120000"/>
            </Sequence>
          </ForceSuccess>
        </Timeout>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Move"
            editable="true">
      <input_port name="goal"/>
      <inout_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="frame_id"
                  default="map"/>
      <input_port name="angular_velocity"
                  default="1.0"/>
      <input_port name="mode"
                  default="7"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="angular_acceleration"
                  default="1.8"/>
      <input_port name="reversing"
                  default="0"/>
    </Action>
    <Action ID="ScoreboardTask"
            editable="true">
      <input_port name="points"
                  default="0">points scored, can be negative</input_port>
      <input_port name="task"
                  default="store_sample_to_work_shed">unique task name</input_port>
    </Action>
    <Action ID="Translate"
            editable="true">
      <input_port name="frame_id"
                  default="base_link"/>
      <input_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="x"/>
      <input_port name="error"
                  default="{error}"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="enable_sensors"
                  default="false"/>
    </Action>
    <Action ID="WaitMatchStart"
            editable="true">
      <input_port name="state"
                  default="2">0 = unarmed; 1 = armed; 2 = started</input_port>
    </Action>
  </TreeNodesModel>

</root>
