                         position="215"
                         tolerance="10"
                         feedback_effort="{feedback_effort}"
                         feedback_position="{feedback_position}"
                         result="{result}"
                         command_mode="0"/>
        </Parallel>
        <Parallel failure_count="1"
                  success_count="-1">
          <JointPosition instance="m61"
                         max_effort="0"
                         max_velocity="180"
                         position="0"
                         tolerance="10"
                         feedback_effort="{feedback_effort}"
                         feedback_position="{feedback_position}"
                         result="{result}"
                         command_mode="0"/>
          <Translate frame_id="base_link"
                     ignore_obstacles="true"
                     x="0.06"
                     error="{error}"
                     linear_velocity="0.5"
                     linear_acceleration="0.8"
                     enable_sensors="false"/>
        </Parallel>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>

