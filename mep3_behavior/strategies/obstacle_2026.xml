<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="add_pantry">
    <Fallback>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;0&quot;"/>
        <AddObstacle label="canary_0"
                     polygon="0.55;-0.2;0.0|0.55;-0.3;0.0|0.45;-0.3;0.0|0.45;-0.2;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;1&quot;"/>
        <AddObstacle label="canary_1"
                     polygon="-0.15;-1.45;0.0|-0.15;-1.55;0.0|-0.25;-1.55;0.0|-0.25;-1.45;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;2&quot;"/>
        <AddObstacle label="canary_2"
                     polygon="-0.95;-0.75;0.0|-0.95;-0.85;0.0|-1.05;-0.85;0.0|-1.05;-0.75;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;3&quot;"/>
        <AddObstacle label="canary_3"
                     polygon="-0.95;0.05;0.0|-0.95;-0.05;0.0|-1.05;-0.05;0.0|-1.05;0.05;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;4&quot;"/>
        <AddObstacle label="canary_4"
                     polygon="-0.95;0.85;0.0|-0.95;0.75;0.0|-1.05;0.75;0.0|-1.05;0.85;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;5&quot;"/>
        <AddObstacle label="canary_5"
                     polygon="-0.15;1.55;0.0|-0.15;1.45;0.0|-0.25;1.45;0.0|-0.25;1.55;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;6&quot;"/>
        <AddObstacle label="canary_6"
                     polygon="0.55;0.3;0.0|0.55;0.2;0.0|0.45;0.2;0.0|0.45;0.3;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;7&quot;"/>
        <AddObstacle label="canary_7"
                     polygon="-0.15;0.75;0.0|-0.15;0.65;0.0|-0.25;0.65;0.0|-0.25;0.75;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;8&quot;"/>
        <AddObstacle label="canary_8"
                     polygon="-0.15;0.05;0.0|-0.15;-0.05;0.0|-0.25;-0.05;0.0|-0.25;0.05;0.0"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="pantry_number == &quot;9&quot;"/>
        <AddObstacle label="canary_9"
                     polygon="-0.15;-0.75;0.0|-0.15;-0.65;0.0|-0.25;-0.65;0.0|-0.25;-0.75;0.0"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="secure_move">
    <ForceSuccess>
      <RetryUntilSuccessful num_attempts="{num_attempts}">
        <Fallback>
          <Move goal="{goal}"
                ignore_obstacles="false"
                linear_velocity="{linear_velocity}"
                frame_id="map"
                angular_velocity="{angular_velocity}"
                mode="{mode}"
                linear_acceleration="{linear_acceleration}"
                angular_acceleration="{angular_acceleration}"
                reversing="0"/>
          <ForceFailure>
            <Sleep msec="{sleep_duration}"/>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="unstuck_move">
    <Fallback>
      <Timeout msec="{duration}">
        <Move name="MoveUnstuck"
              goal="{goal}"
              ignore_obstacles="{ignore_obstacles}"
              linear_velocity="{linear_velocity}"
              frame_id="map"
              angular_velocity="{angular_velocity}"
              mode="{mode}"
              linear_acceleration="{linear_acceleration}"
              angular_acceleration="{angular_acceleration}"
              reversing="0"/>
      </Timeout>
      <Translate frame_id="base_link"
                 ignore_obstacles="false"
                 x="{translate}"
                 error="{error}"
                 linear_velocity="0.5"
                 linear_acceleration="0.8"
                 enable_sensors="false"/>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AddObstacle"
            editable="true">
      <input_port name="label"/>
      <input_port name="polygon"/>
    </Action>
    <Action ID="Move"
            editable="true">
      <input_port name="goal"/>
      <inout_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="frame_id"
                  default="map"/>
      <input_port name="angular_velocity"
                  default="1.0"/>
      <input_port name="mode"
                  default="7"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="angular_acceleration"
                  default="1.8"/>
      <input_port name="reversing"
                  default="0"/>
    </Action>
    <Action ID="Translate"
            editable="true">
      <input_port name="frame_id"
                  default="base_link"/>
      <input_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="x"/>
      <input_port name="error"
                  default="{error}"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="enable_sensors"
                  default="false"/>
    </Action>
  </TreeNodesModel>

</root>
