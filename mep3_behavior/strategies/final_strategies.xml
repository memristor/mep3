<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="full2_yellow_a">
    <Sequence _description="Nije jos nista uradjeno ideja je da se naprai da stane robot kad gura zireve koje je sima supustio da se tu zaustavi">
      <Script code="is_in_home:=false"/>
      <Sleep msec="2000"/>
      <SubTree ID="servo_init"
               _autoremap="true"/>
      <WaitMatchStart state="2"/>
      <ForceSuccess>
        <Timeout msec="100000">
          <ForceSuccess>
            <Sequence>
              <ForceSuccess>
                <Timeout msec="90000">
                  <Sequence>
                    <SubTree ID="yellow_a"
                             _autoremap="true"/>
                    <Sleep msec="5000"/>
                  </Sequence>
                </Timeout>
              </ForceSuccess>
              <SubTree ID="go_home_yellow"
                       _skipIf="is_in_home==true"
                       _autoremap="true"/>
              <ForceSuccess>
                <Parallel failure_count="1"
                          success_count="-1">
                  <SubTree ID="servo_init_red"
                           _autoremap="true"/>
                  <SubTree ID="servo_init_gray"
                           _autoremap="true"/>
                </Parallel>
              </ForceSuccess>
              <Sleep msec="5000"/>
            </Sequence>
          </ForceSuccess>
        </Timeout>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

