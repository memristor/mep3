  <BehaviorTree ID="full_agressive_blue">
    <Sequence>
      <Script code="is_in_home:=false"/>
      <Sleep msec="2000"/>
      <SubTree ID="servo_init"
               _autoremap="true"/>
      <WaitMatchStart state="2"/>
      <ForceSuccess>
        <Timeout msec="100000">
          <ForceSuccess>
            <Sequence>
              <ForceSuccess>
                <Timeout msec="95000">
                  <Sequence>
                    <SubTree ID="aggressive_blue_new"
                             _autoremap="true"/>
                    <Sleep msec="5000"/>
                  </Sequence>
                </Timeout>
              </ForceSuccess>
              <SubTree ID="go_home_blue"
                       _skipIf="is_in_home==true"
                       _autoremap="true"/>
              <Sequence _skipIf="is_in_home==false&#10;">
                <Move goal="0.34;-1.10;-90"
                      ignore_obstacles="true"
                      linear_velocity="3"
                      frame_id="map"
                      angular_velocity="5"
                      mode="2"
                      linear_acceleration="1.5"
                      angular_acceleration="3"
                      reversing="0"/>
                <Move goal="0.81;-1.1;0"
                      ignore_obstacles="true"
                      linear_velocity="3"
                      frame_id="map"
                      angular_velocity="5"
                      mode="7"
                      linear_acceleration="1.5"
                      angular_acceleration="3"
                      reversing="0"/>
              </Sequence>
              <ForceSuccess>
                <Parallel failure_count="1"
                          success_count="-1">
                  <SubTree ID="pumpe_sivo_gasenje"
                           _autoremap="true"/>
                  <SubTree ID="pumpe_crveno_gasenje"
                           _autoremap="true"/>
                </Parallel>
              </ForceSuccess>
              <ForceSuccess>
                <Parallel failure_count="1"
                          success_count="-1">
                  <SubTree ID="servo_init_gray"
                           _autoremap="true"/>
                  <SubTree ID="servo_init_red"
                           _autoremap="true"/>
                </Parallel>
              </ForceSuccess>
              <Sleep msec="5000"/>
            </Sequence>
          </ForceSuccess>
        </Timeout>
      </ForceSuccess>
      <ForceSuccess>
        <Parallel failure_count="1"
                  success_count="-1">
          <SubTree ID="pumpe_sivo_gasenje"
                   _autoremap="true"/>
          <SubTree ID="pumpe_crveno_gasenje"
                   _autoremap="true"/>
