  <BehaviorTree ID="go_home_blue">
    <Sequence>
      <RetryUntilSuccessful num_attempts="5">
        <Fallback>
          <Navigate behavior_tree=""
                    goal="0.7;-1.3;0"/>
          <Sequence>
            <Sleep msec="500"/>
            <AlwaysFailure/>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <RetryUntilSuccessful num_attempts="5">
