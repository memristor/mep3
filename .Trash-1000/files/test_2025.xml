                     _autoremap="true"/>
            <Translate frame_id="base_link"
                       ignore_obstacles="false"
                       x="-0.1"
                       error="{error}"
                       linear_velocity="0.5"
                       linear_acceleration="0.8"
                       enable_sensors="false"/>
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <SubTree ID="build_two_floors_back"
               _autoremap="true"/>
      <Move goal="-0.65;0.27;180"
            ignore_obstacles="false"
            linear_velocity="0.7"
            frame_id="map"
            angular_velocity="1.2"
            mode="7"
            linear_acceleration="1"
            angular_acceleration="1.8"
            reversing="0"/>
      <SubTree ID="build_two_floors_front"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="yellow_a_139">
    <Sequence>
      <WaitMatchStart state="2"/>
      <ForceSuccess>
        <Timeout msec="100000">
          <ForceSuccess>
            <Sequence>
              <ForceSuccess>
                <Timeout msec="85000">
                  <Sequence>
                    <SubTree ID="yellow_139"
                             _autoremap="true"/>
                    <Sleep msec="120000"/>
                  </Sequence>
                </Timeout>
              </ForceSuccess>
              <Sleep msec="120000"/>
            </Sequence>
          </ForceSuccess>
        </Timeout>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="JointPosition"
            editable="true">
      <input_port name="instance"/>
      <input_port name="max_effort"
                  default="0"/>
      <input_port name="max_velocity"
                  default="180"/>
      <input_port name="position"/>
      <input_port name="tolerance"
                  default="10"/>
      <output_port name="feedback_effort"
                   default="{feedback_effort}"/>
      <output_port name="feedback_position"
                   default="{feedback_position}"/>
      <output_port name="result"
                   default="{result}"/>
      <input_port name="command_mode"
                  default="0"/>
    </Action>
    <Action ID="Move"
            editable="true">
      <input_port name="goal"/>
      <inout_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="frame_id"
                  default="map"/>
      <input_port name="angular_velocity"
                  default="1.0"/>
      <input_port name="mode"
                  default="7"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="angular_acceleration"
                  default="1.8"/>
      <input_port name="reversing"
                  default="0"/>
    </Action>
    <Action ID="Pump"
            editable="true">
      <input_port name="connect"
                  default="1"/>
      <input_port name="instance"/>
    </Action>
    <Action ID="Rotate"
            editable="true">
      <input_port name="angle"/>
      <input_port name="angular_velocity"
                  default="1.5"/>
      <input_port name="frame_id"
                  default="base_link"/>
      <input_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="error"
                  default="{error}"/>
      <input_port name="angular_acceleration"
                  default="1.8"/>
    </Action>
    <Action ID="Translate"
            editable="true">
      <input_port name="frame_id"
                  default="base_link"/>
      <input_port name="ignore_obstacles"
                  default="false"/>
      <input_port name="x"/>
      <input_port name="error"
                  default="{error}"/>
      <input_port name="linear_velocity"
                  default="0.5"/>
      <input_port name="linear_acceleration"
                  default="0.8"/>
      <input_port name="enable_sensors"
                  default="false"/>
    </Action>
    <Action ID="WaitMatchStart"
            editable="true">
      <input_port name="state"
                  default="2">0 = unarmed; 1 = armed; 2 = started</input_port>
    </Action>
  </TreeNodesModel>

</root>
