<?xml version="1.0"?>
<robot name="MemristorBig">
    <link name="base_link" />

    <ros2_control name="HardwareControl" type="system">
        <hardware>
            <plugin>mep3_hardware::MotionHardwareInterface</plugin>
            <param name="kp_linear">40.0</param> <!--96-->
            <param name="ki_linear">1.0</param>
            <param name="kd_linear">0.1</param>

            <param name="kp_angular">50.0</param> <!--110-->
            <param name="ki_angular">2.0</param>
            <param name="kd_angular">0.0</param>

            <param name="update_rate">100.0</param>

            <param name="interface_name">can0</param>
            <param name="can_id">0x00006C01</param>
            <param name="can_mask">0x1FFFFFF8</param>

        </hardware>
        <joint name="left_motor">
            <state_interface name="position" />
            <command_interface name="velocity" />
        </joint>
        <joint name="right_motor">
            <state_interface name="position" />
            <command_interface name="velocity" />
        </joint>
    </ros2_control>
    
     <ros2_control name="gpio_interface" type="system">
        <hardware>
            <plugin>mep3_hardware::CanGpioHardwareInterface</plugin>
            <param name="interface_name">can0</param>
            <param name="can_id">0x00006C01</param>
            <param name="can_mask">0x1FFFFFF8</param>
        </hardware>
        
        <gpio name="pump1_pump">
            <param name="index">5</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump1_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        
         <gpio name="pump2_pump">
            <param name="index">4</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump2_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump3_pump">
            <param name="index">1</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump3_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump4_pump">
            <param name="index">2</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump4_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump5_pump">
            <param name="index">7</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump5_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump6_pump">
            <param name="index">3</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump6_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump7_pump">
            <param name="index">8</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump7_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump8_pump">
            <param name="index">8</param>
            <command_interface name="output"/>
        </gpio>
        <gpio name="pump8_valve">
            <param name="index">9</param>
            <command_interface name="output"/>
        </gpio>
    </ros2_control>

    <ros2_control name="ax_dynamixels" type="system">
        <hardware>
            <plugin>dynamixel_hardware/DynamixelHardware</plugin>
            <param name="usb_port">/dev/serial/by-path/pci-0000:00:14.0-usb-0:2.4:1.0-port0</param>
            <param name="baud_rate">115200</param>
            <param name="use_dummy">false</param>
            <param name="offset">2.618</param>
        </hardware>
        <joint name="m11">
            <param name="id">11</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint> 
        <joint name="m12">
            <param name="id">12</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="m13">
